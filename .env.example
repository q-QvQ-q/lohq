# Supabase Configuration
# Get these values from your Supabase project settings:
# https://supabase.com/dashboard/project/<your-project>/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================
# Vercel proxy (recommended for this Vercel deployment)
# ============================================
# This routes Supabase requests through api/[...path].js on the same origin.
VITE_SUPABASE_PROXY_URL=/api
