# Supabase Configuration
# Get these values from your Supabase project settings:
# https://supabase.com/dashboard/project/<your-project>/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================
# Cloudflare Worker Proxy (for China access)
# ============================================
# If your site will be accessed from mainland China, you need a Worker proxy
# because supabase.co and vercel.app are blocked by GFW.
#
# Step 1: Deploy the Worker (see cloudflare-worker/ directory)
# Step 2: After deployment, set the Worker URL below:
#
#   VITE_SUPABASE_PROXY_URL=https://lohq-supabase-proxy.xxx.workers.dev
#
# For local development with the Worker deployed:
#
#   VITE_SUPABASE_PROXY_URL=/supabase-proxy
#   VITE_SUPABASE_WORKER_URL=https://lohq-supabase-proxy.xxx.workers.dev
